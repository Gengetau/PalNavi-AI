+    private static int Enrich(string pakDirectory, string? mappings, string buildId, string output)
+    {
+        if (buildId == "unknown") throw new ArgumentException("--build-id is required for enrich");
+        if (!string.IsNullOrWhiteSpace(mappings))
+            throw new ArgumentException("The reviewed enrichment extraction requires no mappings file");
+        using var workspace = new PakWorkspace(pakDirectory, null);
+        var snapshot = new EnrichmentExtractor(workspace).Extract(buildId);
+        Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(output))!);
+        File.WriteAllText(output, JsonSerializer.Serialize(snapshot, EnrichmentJsonOptions) + "\n");
+        Console.WriteLine(
+            $"Extracted {snapshot.PalTable.RowCount} Pal rows and " +
+            $"{snapshot.ActiveSkillTable.RowCount} active-skill rows");
+        return 0;
+    }
+
